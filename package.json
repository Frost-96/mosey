{
  "name": "mosey",
  "productName": "Mosey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.mjs",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "package:mac": "electron-forge package --platform=darwin --arch=arm64",
    "test": "vitest run",
    "test:dev": "vitest run --project development",
    "test:packaged": "vitest run --project packaged",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm test:inventory && pnpm typecheck && pnpm lint && pnpm format:check",
    "postinstall": "install-electron",
    "assets:build": "node tools/build-assets.ts",
    "measure:resources": "node tools/measure-resources.ts",
    "prestart": "pnpm assets:build && pnpm native:build",
    "prebuild": "pnpm assets:build && pnpm native:build",
    "prepackage:mac": "pnpm assets:build && pnpm native:build",
    "native:build": "node tools/build-dock-helper.ts",
    "test:deterministic": "vitest run --project deterministic",
    "test:inventory": "node tools/check-test-inventory.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "config": {
    "forge": "./forge.config.ts"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  }
}
